# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backblaze B2 (S3-compatible) — where movie files actually live.
# Create an Application Key scoped to your bucket; B2_KEY_ID is that
# key's "keyID", B2_APPLICATION_KEY is its "applicationKey".
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Optional but recommended — locks the daily room-cleanup cron
# (see vercel.json) to Vercel's own scheduler. Any random string;
# generate one with: openssl rand -hex 32
CRON_SECRET=
